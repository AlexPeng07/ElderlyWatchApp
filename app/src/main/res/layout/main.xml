<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="match_parent"
    android:orientation="vertical" android:background="#F0F4F8">
    <LinearLayout android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" android:orientation="vertical">
        <ScrollView android:id="@+id/scroll_dashboard" android:layout_width="match_parent" android:layout_height="match_parent" android:padding="16dp" android:scrollbars="none">
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical">
                <Button android:layout_width="match_parent" android:layout_height="60dp" android:layout_marginBottom="16dp"
                    android:backgroundTint="#2196F3" android:onClick="onMapButtonClicked" android:text="老人物联网手环守护网站"
                    android:textColor="#FFFFFF" android:textSize="18sp" android:textStyle="bold" />
                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:baselineAligned="false" android:orientation="horizontal">
                    <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:layout_marginEnd="8dp"
                        android:layout_marginBottom="16dp" android:background="#FFFFFF" android:elevation="4dp" android:gravity="center" android:orientation="vertical" android:padding="16dp">
                        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="实时心率" android:textColor="#888888" android:textSize="20sp" android:textStyle="bold" />
                        <LinearLayout android:layout_width="wrap_content" android:layout_height="wrap_content" android:gravity="bottom" android:orientation="horizontal">
                            <TextView android:id="@+id/textViewHeartrate" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="0" android:textColor="#E53935" android:textSize="50sp" android:textStyle="bold" />
                            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginBottom="8dp" android:text=" bmp" android:textColor="#888888" android:textSize="16sp" />
                        </LinearLayout>
                    </LinearLayout>
                    <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:layout_marginStart="8dp"
                        android:layout_marginBottom="16dp" android:background="#FFFFFF" android:elevation="4dp" android:gravity="center" android:orientation="vertical" android:padding="16dp">
                        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="体表温度" android:textColor="#888888" android:textSize="20sp" android:textStyle="bold" />
                        <LinearLayout android:layout_width="wrap_content" android:layout_height="wrap_content" android:gravity="bottom" android:orientation="horizontal">
                            <TextView android:id="@+id/textViewTemperature" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="0" android:textColor="#FB8C00" android:textSize="50sp" android:textStyle="bold" />
                            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginBottom="8dp" android:text=" ℃" android:textColor="#888888" android:textSize="16sp" />
                        </LinearLayout>
                    </LinearLayout>
                </LinearLayout>
                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginBottom="16dp"
                    android:background="#FFFFFF" android:elevation="4dp" android:gravity="center" android:orientation="vertical" android:padding="16dp">
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="今日运动步数" android:textColor="#888888" android:textSize="20sp" android:textStyle="bold" />
                    <TextView android:id="@+id/textViewSteps" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="0" android:textColor="#1E88E5" android:textSize="50sp" android:textStyle="bold" />
                </LinearLayout>
                <TextView android:id="@+id/diedao" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginBottom="16dp"
                    android:background="#EEEEEE" android:elevation="2dp" android:gravity="center" android:padding="16dp" android:text="手环未连接"
                    android:textColor="#757575" android:textSize="24sp" android:textStyle="bold" />
                <Button android:id="@+id/btn_emergency" android:layout_width="match_parent" android:layout_height="90dp" android:layout_marginBottom="24dp"
                    android:backgroundTint="#D32F2F" android:onClick="onEmergencyButtonClicked" android:text="急病 / 跌倒一键求助"
                    android:textColor="#FFFFFF" android:textSize="30sp" android:textStyle="bold" />
                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:background="#FFFFFF" android:elevation="2dp" android:orientation="vertical" android:padding="16dp">
                    <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginBottom="16dp" android:text="报警参数微调 (家属专用)" android:textColor="#999999" android:textSize="16sp" />
                    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginBottom="8dp" android:gravity="center_vertical" android:orientation="horizontal">
                        <TextView android:layout_width="80dp" android:layout_height="wrap_content" android:text="心率下限:" android:textSize="16sp" />
                        <Button android:layout_width="50dp" android:layout_height="50dp" android:onClick="onDecHeartrateMinClicked" android:text="-" />
                        <TextView android:id="@+id/textViewSetHeartrateMin" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:gravity="center" android:text="60" android:textSize="22sp" android:textStyle="bold" />
                        <Button android:layout_width="50dp" android:layout_height="50dp" android:onClick="onAddHeartrateMinClicked" android:text="+" />
                    </LinearLayout>
                    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginBottom="16dp" android:gravity="center_vertical" android:orientation="horizontal">
                        <TextView android:layout_width="80dp" android:layout_height="wrap_content" android:text="心率上限:" android:textSize="16sp" />
                        <Button android:layout_width="50dp" android:layout_height="50dp" android:onClick="onDecHeartrateMaxClicked" android:text="-" />
                        <TextView android:id="@+id/textViewSetHeartrateMax" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:gravity="center" android:text="120" android:textSize="22sp" android:textStyle="bold" />
                        <Button android:layout_width="50dp" android:layout_height="50dp" android:onClick="onAddHeartrateMaxClicked" android:text="+" />
                    </LinearLayout>
                    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginBottom="8dp" android:gravity="center_vertical" android:orientation="horizontal">
                        <TextView android:layout_width="80dp" android:layout_height="wrap_content" android:text="温度下限:" android:textSize="16sp" />
                        <Button android:layout_width="50dp" android:layout_height="50dp" android:onClick="onDecTempMinClicked" android:text="-" />
                        <TextView android:id="@+id/textViewTempMin" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:gravity="center" android:text="15.0" android:textSize="22sp" android:textStyle="bold" />
                        <Button android:layout_width="50dp" android:layout_height="50dp" android:onClick="onAddTempMinClicked" android:text="+" />
                    </LinearLayout>
                    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="center_vertical" android:orientation="horizontal">
                        <TextView android:layout_width="80dp" android:layout_height="wrap_content" android:text="温度上限:" android:textSize="16sp" />
                        <Button android:layout_width="50dp" android:layout_height="50dp" android:onClick="onDecTempMaxClicked" android:text="-" />
                        <TextView android:id="@+id/textViewTempMax" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:gravity="center" android:text="37.3" android:textSize="22sp" android:textStyle="bold" />
                        <Button android:layout_width="50dp" android:layout_height="50dp" android:onClick="onAddTempMaxClicked" android:text="+" />
                    </LinearLayout>
                </LinearLayout>
                <Button android:layout_width="match_parent" android:layout_height="60dp" android:layout_marginTop="16dp" android:backgroundTint="#673AB7"
                    android:onClick="onAdminButtonClicked" android:text="老人物联网手环守护网站管理员端" android:textColor="#FFFFFF" android:textSize="18sp" android:textStyle="bold" />
                <Button android:layout_width="match_parent" android:layout_height="60dp" android:layout_marginTop="16dp" android:backgroundTint="#00897B"
                    android:onClick="onSmsNumberButtonClicked" android:text="更改短信通知号码" android:textColor="#FFFFFF" android:textSize="18sp" android:textStyle="bold" />
            </LinearLayout>
        </ScrollView>
        <WebView android:id="@+id/webView_map" android:layout_width="match_parent" android:layout_height="match_parent" android:visibility="gone" />
    </LinearLayout>
    <LinearLayout android:id="@+id/ll_bottom_buttons" android:layout_width="match_parent" android:layout_height="wrap_content" android:background="#FFFFFF" android:elevation="16dp" android:orientation="horizontal" android:padding="8dp">
        <Button android:id="@+id/butConnect" android:layout_width="0dp" android:layout_height="70dp" android:layout_weight="1.2" android:layout_marginEnd="6dp"
            android:backgroundTint="#4CAF50" android:onClick="onConnectButtonClicked" android:text="连接手环" android:textColor="#FFFFFF" android:textSize="22sp" android:textStyle="bold" />
        <Button android:id="@+id/butDisconnect" android:layout_width="0dp" android:layout_height="70dp" android:layout_weight="1" android:layout_marginEnd="6dp"
            android:backgroundTint="#FF9800" android:onClick="onDisconnectionClicked" android:text="断开" android:textColor="#FFFFFF" android:textSize="20sp" android:textStyle="bold" />
        <Button android:id="@+id/butExit" android:layout_width="0dp" android:layout_height="70dp" android:layout_weight="0.8"
            android:backgroundTint="#9E9E9E" android:onClick="onExitButtonClicked" android:text="退出" android:textColor="#FFFFFF" android:textSize="20sp" android:textStyle="bold" />
    </LinearLayout>
</LinearLayout>
